// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum TwoFactorAuditAction {
  ENABLED
  DISABLED
  RECOVERY_CODES_REGENERATED
  RECOVERY_CODE_USED
}

model User {
  id               String   @id @default(uuid())
  email            String   @unique
  phone            String   @unique
  password         String
  name             String
  isPhoneVerified  Boolean  @default(false)
  verificationCode String?
  role             Role     @default(USER)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  twoFactorEnabled Boolean @default(false)
  // Cifrado (AES-256-GCM), nunca em texto puro — ver two-factor-crypto.util.ts
  twoFactorSecret  String?

  // Segredo pendente do setup de 2FA (cifrado), antes da confirmação
  twoFactorPendingSecret          String?
  twoFactorPendingSecretExpiresAt DateTime?

  // Sessão ativa de refresh token — um token válido por vez, com rotação
  refreshTokenId        String?
  refreshTokenExpiresAt DateTime?

  recoveryCodes            TwoFactorRecoveryCode[]
  twoFactorAudits          TwoFactorAuditLog[]
  twoFactorLoginChallenges TwoFactorLoginChallenge[]

  @@map("users")
}

model TwoFactorRecoveryCode {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // bcrypt — só precisa comparar, nunca decriptar, ao contrário do twoFactorSecret
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("two_factor_recovery_codes")
}

model TwoFactorAuditLog {
  id        String                @id @default(uuid())
  userId    String
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    TwoFactorAuditAction
  createdAt DateTime              @default(now())

  @@index([userId, createdAt])
  @@map("two_factor_audit_logs")
}

// Estado entre POST /auth/login (com 2FA ativo) e POST /auth/2fa/verify.
// O id é o próprio challengeToken (randomUUID) — não um id opaco separado.
model TwoFactorLoginChallenge {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("two_factor_login_challenges")
}
